                isHolding = false
                local elapsed = os.clock() - dragStartTime
                local delta = (input.Position - dragStartInputPos).Magnitude
                if not isDragging and (elapsed < 0.35 and delta < 10) then
                    triggerToggle()
                elseif isDragging then
                    -- Snap cleanly to nearest edge (left 18px or right edge)
                    local vp = getViewport()
                    local currentAbsX = floatBtn.AbsolutePosition.X
                    local targetX = (currentAbsX < vp.X / 2) and 18 or math.max(18, vp.X - 70)
                    local currentAbsY = math.clamp(floatBtn.AbsolutePosition.Y, 36, math.max(36, vp.Y - 60))
                    local endPos = UDim2.new(0, targetX, 0, currentAbsY)
                    restingPos = endPos
                    makeTween(floatBtn, 0.22, {
                        Position = endPos
                    })
                end
                dragStartInputPos = Vector3.zero
                isDragging = false
            end
        end)

        table.insert(DiceUI._connections, fConn1)
        table.insert(DiceUI._connections, fConn2)
        table.insert(DiceUI._connections, fConn3)
    end

