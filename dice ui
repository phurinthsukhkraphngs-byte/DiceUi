                local pctLbl = Instance.new("TextLabel")
                pctLbl.Size = UDim2.new(0, 48, 0, 16)
                pctLbl.Position = UDim2.new(1, 0, 0, 0)
                pctLbl.AnchorPoint = Vector2.new(1, 0)
                pctLbl.BackgroundTransparency = 1
                pctLbl.Font = Theme.FontBold
                pctLbl.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
                pctLbl.TextColor3 = color
                pctLbl.TextSize = 10
                pctLbl.TextXAlignment = Enum.TextXAlignment.Right
                pctLbl.Active = false
                pctLbl.Parent = row

                local track = Instance.new("Frame")
                track.Size = UDim2.new(1, 0, 0, 6)
                track.Position = UDim2.new(0, 0, 1, -6)
                track.BackgroundColor3 = Theme.ItemTrack
                track.BorderSizePixel = 0
                track.Active = false
                addCorner(track, 3)
                track.Parent = row

                local fill = Instance.new("Frame")
                fill.Size = UDim2.new(value, 0, 1, 0)
                fill.BackgroundColor3 = color
                fill.BorderSizePixel = 0
                fill.Active = false
                addCorner(fill, 3)
                fill.Parent = track

                if pCfg.Animated then
                    local shimmer = Instance.new("UIGradient")
                    shimmer.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, color),
                        ColorSequenceKeypoint.new(0.5, Theme.AccentLight),
                        ColorSequenceKeypoint.new(1, color)
                    })
                    shimmer.Offset = Vector2.new(-1, 0)
                    shimmer.Parent = fill
                    task.spawn(function()
                        while fill.Parent do
                            shimmer.Offset = Vector2.new(-1, 0)
                            local tw = makeTween(shimmer, 1.6, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                            tw.Completed:Wait()
                            task.wait(0.4)
                        end
                    end)
                end

                local progObj = {
                    Value = value,
                    SetValue = function(self, v: number)
                        v = math.clamp(v, 0, 1)
                        self.Value = v
                        pctLbl.Text = string.format("%d%%", math.floor(v * 100 + 0.5))
                        makeTween(fill, 0.25, { Size = UDim2.new(v, 0, 1, 0) })
                    end
                }
                DiceUI.Options[id] = progObj
                task.defer(adaptColumns)
                return progObj
            end

