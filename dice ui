            --==================================================
            function Section:AddDivider(text: string?)
                elementOrder = elementOrder + 1
                if text and text ~= "" then
                    local divContainer = Instance.new("Frame")
                    divContainer.BorderSizePixel = 0
                    divContainer.Size = UDim2.new(1, 0, 0, 16)
