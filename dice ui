            --==================================================
            function Section:AddProgressBar(id: string, pCfg: {
                Name: string,
                Value: number?,
                Color: Color3?,
                Animated: boolean?
            })
                elementOrder = elementOrder + 1
                local pName = pCfg.Name or id
                local value = math.clamp(pCfg.Value or 0, 0, 1)
                local color = pCfg.Color or Theme.Accent

                local row = Instance.new("Frame")
                row.Name = "Progress_" .. id
                row.Size = UDim2.new(1, 0, 0, 38)
                row.BackgroundColor3 = Theme.ItemBg
                row.BackgroundTransparency = 0.5
                row.Active = false
