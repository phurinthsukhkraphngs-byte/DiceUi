-- Notification Manager
function DiceUI:Notify(cfg: {
    Title: string?,
    Content: string,
    Duration: number?,
    Type: string?
})
    local parent = DiceUI._activeGui
    if not parent then return end

    local notifyHolder = parent:FindFirstChild("DiceNotifyHolder") :: Frame?
    if not notifyHolder then
        local holder = Instance.new("Frame")
        holder.BorderSizePixel = 0
        holder.Name = "DiceNotifyHolder"
        holder.Size = UDim2.new(0, 300, 1, -40)
        holder.Position = UDim2.new(1, -315, 0, 20)
        holder.BackgroundTransparency = 1
        holder.ZIndex = 9999
        holder.Parent = parent

        local list = Instance.new("UIListLayout")
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.VerticalAlignment = Enum.VerticalAlignment.Bottom
        list.Padding = UDim.new(0, 8)
        list.Parent = holder
        notifyHolder = holder
    end

    local titleText = cfg.Title or "DiceHUB"
    local contentText = cfg.Content or ""
    local duration = cfg.Duration or 3.0

    local card = Instance.new("Frame")
    card.Name = "Toast"
    card.Size = UDim2.new(1, 0, 0, 56)
    card.BackgroundColor3 = Theme.CardBg
    card.BackgroundTransparency = 0.05
    card.ClipsDescendants = true
    addCorner(card, 8)
    local nType = string.lower(cfg.Type or "info")
