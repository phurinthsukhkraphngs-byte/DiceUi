-- Clean Unload
function DiceUI:Unload()
    for _, conn in ipairs(self._connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(self._connections)

    for _, win in ipairs(self.Windows) do
        pcall(function() win._gui:Destroy() end)
    end
    table.clear(self.Windows)

    if self._activeGui then
        pcall(function() self._activeGui:Destroy() end)
        self._activeGui = nil
    end

    table.clear(self.Toggles)
    table.clear(self.Options)

    if typeof(getgenv) == "function" then
        local g = getgenv()
        g.DiceUI = nil
        g.Toggles = nil
        g.Options = nil
    end
    print("[DiceUI] Cleanly unloaded all connections and GUIs.")
end

-- Smart Icon Resolver with Fuzzy / Semantic Alias Support
function DiceUI:GetIcon(iconOrName: string?): string
