                    lLine.Position = UDim2.new(0, 0, 0.5, 0)
                    lLine.BackgroundColor3 = Theme.Border
                    lLine.BackgroundTransparency = 0.6
                    lLine.BorderSizePixel = 0
                    lLine.Parent = divContainer

                    local rLine = Instance.new("Frame")
                    rLine.Size = UDim2.new(0.5, -35, 0, 1)
                    rLine.Position = UDim2.new(1, 0, 0.5, 0)
                    rLine.AnchorPoint = Vector2.new(1, 0)
                    rLine.BackgroundColor3 = Theme.Border
                    rLine.BackgroundTransparency = 0.6
                    rLine.BorderSizePixel = 0
                    rLine.Parent = divContainer

                    local midLbl = Instance.new("TextLabel")
                    midLbl.Size = UDim2.new(0, 70, 1, 0)
                    midLbl.Position = UDim2.new(0.5, 0, 0.5, 0)
                    midLbl.AnchorPoint = Vector2.new(0.5, 0.5)
                    midLbl.BackgroundTransparency = 1
                    midLbl.Font = Theme.FontBold
                    midLbl.Text = text:upper()
                    midLbl.TextColor3 = Theme.TextDim
                    midLbl.TextSize = 8
                    midLbl.Parent = divContainer

                    task.defer(adaptColumns)
                    return divContainer
                else
                    local div = Instance.new("Frame")
                    div.Size = UDim2.new(1, 0, 0, 1)
                    div.BackgroundColor3 = Theme.Border
                    div.BackgroundTransparency = 0.6
                    div.BorderSizePixel = 0
                    div.Active = false
                    div.LayoutOrder = elementOrder
                    div.Parent = card
                    task.defer(adaptColumns)
                    return div
                end
            end

            task.defer(adaptColumns)
            return Section
        end

        table.insert(Window._tabs, Tab)
        if #Window._tabs == 1 then
            Tab:Select()
        end
        return Tab
    end

    return Window
end


