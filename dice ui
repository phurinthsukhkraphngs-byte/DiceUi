    -- Direct asset ID or thumbnail URI pass-through
    if string.find(iconOrName, "://") then
        return iconOrName
    end
    -- Exact key match in Icons table
    if Icons[iconOrName] then
        return Icons[iconOrName]
    end
    -- Normalized case-insensitive lookup
    local lower = string.lower(iconOrName):gsub("[%s%-_]+", "")
    for name, assetId in pairs(Icons) do
        local nLower = string.lower(name):gsub("[%s%-_]+", "")
