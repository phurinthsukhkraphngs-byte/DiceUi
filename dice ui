                -- 3D Tactile Switch Knob (12x12px with pure specular gloss)
                local switchKnob = Instance.new("Frame")
                switchKnob.Name = "SwitchKnob"
                switchKnob.Size = UDim2.new(0, 12, 0, 12)
                switchKnob.Position = state and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
                switchKnob.AnchorPoint = Vector2.new(0, 0.5)
                switchKnob.BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Theme.TextMuted
                switchKnob.Active = false
                addCorner(switchKnob, 6)
                addStroke(switchKnob, Color3.fromRGB(255, 255, 255), 1, state and 0.2 or 0.7)
                switchKnob.Parent = switchTrack

                local toggleObj = {
                    Value = state,
                    SetValue = function(self, val: boolean)
                        self.Value = val
                        trackGrad.Enabled = val
                        makeTween(switchTrack, 0.18, {
                            BackgroundColor3 = val and Theme.Accent or Theme.ItemTrack
                        })
                        makeTween(trackStroke, 0.18, {
                            Color = val and Theme.Accent or Theme.Border,
                            Transparency = val and 0.3 or 0.8
                        })
                        makeTween(switchKnob, 0.18, {
                            Position = val and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                            BackgroundColor3 = val and Color3.fromRGB(255, 255, 255) or Theme.TextMuted
                        })
                        if callback then task.spawn(callback, val) end
                    end
                }

                -- Responsive Click Target:
                -- On desktop PC, cover entire row for effortless 1-click toggling.
                -- On mobile touch, cover the switch pill area (right 52px) so the left 80% remains completely open for smooth scrolling!
                local triggerBtn = Instance.new("TextButton")
                triggerBtn.Name = "Trigger"
                triggerBtn.BackgroundTransparency = 1
                triggerBtn.Text = ""
                triggerBtn.AutoButtonColor = false
                triggerBtn.ZIndex = 3
                if UserInputService.TouchEnabled then
                    triggerBtn.Size = UDim2.new(0, 56, 1, 0)
                    triggerBtn.Position = UDim2.new(1, -56, 0, 0)
                else
                    triggerBtn.Size = UDim2.new(1, 0, 1, 0)
                    triggerBtn.Position = UDim2.new(0, 0, 0, 0)
                end
                triggerBtn.Parent = row

                triggerBtn.MouseButton1Click:Connect(function()
                    toggleObj:SetValue(not toggleObj.Value)
                end)

                triggerBtn.MouseEnter:Connect(function()
                    makeTween(row, 0.15, { BackgroundTransparency = 0.25 })
                    makeTween(rowStroke, 0.15, { Color = Theme.Accent, Transparency = 0.4 })
                end)
                triggerBtn.MouseLeave:Connect(function()
                    makeTween(row, 0.15, { BackgroundTransparency = 0.5 })
                    makeTween(rowStroke, 0.15, { Color = Theme.Border, Transparency = 0.75 })
                end)

                DiceUI.Toggles[id] = toggleObj
                task.defer(adaptColumns)
                return toggleObj
            end

            --==================================================
            -- CONTROL: SLIDER (COMPACT 38PX ROW, 4PX TRACK, 10PX THUMB)
            --==================================================
            function Section:AddSlider(id: string, sCfg: {
                Name: string,
                Min: number?,
                Max: number?,
                Default: number?,
                Decimals: number?,
                Suffix: string?,
                Callback: ((number) -> ())?
            })
                elementOrder = elementOrder + 1
                local sName = sCfg.Name or id
                local minVal = sCfg.Min or 0
                local maxVal = sCfg.Max or 100
                local defaultVal = math.clamp(sCfg.Default or minVal, minVal, maxVal)
                local decimals = sCfg.Decimals or 0
                local suffix = sCfg.Suffix or ""
                local callback = sCfg.Callback

                local row = Instance.new("Frame")
                row.Name = "Slider_" .. id
                row.Size = UDim2.new(1, 0, 0, 38)
                row.BackgroundColor3 = Theme.ItemBg
                row.BackgroundTransparency = 0.5
                row.Active = false
                row.LayoutOrder = elementOrder
                row.ClipsDescendants = true
                addCorner(row, 6)
                addStroke(row, Theme.Border, 1, 0.75)
                addPadding(row, 5, 5, 8, 8)
                row.Parent = card

                -- Line 1: Title on Left, Value Tag on Right
                local topLine = Instance.new("Frame")
                topLine.BorderSizePixel = 0
                topLine.Size = UDim2.new(1, 0, 0, 16)
                topLine.BackgroundTransparency = 1
                topLine.Active = false
                topLine.Parent = row

                local titleLbl = Instance.new("TextLabel")
                titleLbl.Size = UDim2.new(1, -64, 1, 0)
                titleLbl.BackgroundTransparency = 1
                titleLbl.Font = Theme.FontMedium
                titleLbl.Text = sName
                titleLbl.TextColor3 = Theme.TextBody
                titleLbl.TextSize = 11
                titleLbl.TextXAlignment = Enum.TextXAlignment.Left
                titleLbl.TextTruncate = Enum.TextTruncate.None
                titleLbl.Active = false
                titleLbl.Parent = topLine

                local valBadge = Instance.new("Frame")
                valBadge.Size = UDim2.new(0, 60, 0, 16)
                valBadge.Position = UDim2.new(1, 0, 0, 0)
                valBadge.AnchorPoint = Vector2.new(1, 0)
                valBadge.BackgroundColor3 = Theme.CardBg
                valBadge.BackgroundTransparency = 0.3
                valBadge.Active = false
                addCorner(valBadge, 4)
                addStroke(valBadge, Theme.Border, 1, 0.75)
                valBadge.Parent = topLine

                local function formatValue(v: number): string
                    if decimals == 0 then
                        return string.format("%d", math.floor(v + 0.5))
                    else
                        return string.format("%." .. tostring(decimals) .. "f", v)
                    end
                end

                local valLbl = Instance.new("TextLabel")
                valLbl.Size = UDim2.new(1, 0, 1, 0)
                valLbl.BackgroundTransparency = 1
                valLbl.Font = Theme.FontBold
                valLbl.Text = formatValue(defaultVal) .. suffix
                valLbl.TextColor3 = Theme.Accent
                valLbl.TextSize = 10
                valLbl.Active = false
                valLbl.Parent = valBadge

                -- Line 2: Sleek 4px Interactive Track
                local trackHitbox = Instance.new("TextButton")
                trackHitbox.Size = UDim2.new(1, 0, 0, 14)
                trackHitbox.Position = UDim2.new(0, 0, 1, -13)
                trackHitbox.BackgroundTransparency = 1
                trackHitbox.Text = ""
                trackHitbox.AutoButtonColor = false
                trackHitbox.Active = true
                trackHitbox.Parent = row

                local track = Instance.new("Frame")
                track.Size = UDim2.new(1, 0, 0, 4)
                track.Position = UDim2.new(0, 0, 0.5, -2)
                track.BackgroundColor3 = Theme.ItemTrack
                track.BorderSizePixel = 0
                addCorner(track, 2)
                track.Parent = trackHitbox

                local fill = Instance.new("Frame")
                local relAlpha = (maxVal > minVal) and ((defaultVal - minVal) / (maxVal - minVal)) or 0
                fill.Size = UDim2.new(relAlpha, 0, 1, 0)
                fill.BackgroundColor3 = Theme.Accent
                fill.BorderSizePixel = 0
                addCorner(fill, 2)
                fill.Parent = track

                local fillGrad = Instance.new("UIGradient")
                fillGrad.Color = Theme.AccentGradient
                fillGrad.Parent = fill

                -- 10px Glowing Thumb
                local knob = Instance.new("Frame")
                knob.Size = UDim2.new(0, 10, 0, 10)
                knob.Position = UDim2.new(1, -5, 0.5, 0)
                knob.AnchorPoint = Vector2.new(0, 0.5)
                knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                addCorner(knob, 5)
                addStroke(knob, Theme.Accent, 1, 0.3)
                knob.Parent = fill

                local sliderObj = {
                    Value = defaultVal,
                    SetValue = function(self, val: number)
                        val = math.clamp(val, minVal, maxVal)
                        if decimals == 0 then
                            val = math.floor(val + 0.5)
                        else
                            local mult = 10 ^ decimals
                            val = math.floor(val * mult + 0.5) / mult
                        end
                        self.Value = val
                        valLbl.Text = formatValue(val) .. suffix
                        local alpha = (maxVal > minVal) and ((val - minVal) / (maxVal - minVal)) or 0
                        makeTween(fill, 0.06, { Size = UDim2.new(alpha, 0, 1, 0) })
                        if callback then task.spawn(callback, val) end
                    end
                }

                -- Interaction
                local dragging = false
                local function updateFromInput(input)
                    local trackAbsPos = track.AbsolutePosition.X
                    local trackAbsSize = math.max(track.AbsoluteSize.X, 1)
                    local mouseX = input.Position.X
                    local alpha = math.clamp((mouseX - trackAbsPos) / trackAbsSize, 0, 1)
                    local val = minVal + alpha * (maxVal - minVal)
                    sliderObj:SetValue(val)
                end

                trackHitbox.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        page.ScrollingEnabled = false
                        makeTween(knob, 0.1, { Size = UDim2.new(0, 12, 0, 12) })
                        updateFromInput(input)
                    end
                end)

                local sConn1 = UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if dragging then
                            dragging = false
                            page.ScrollingEnabled = true
                            makeTween(knob, 0.1, { Size = UDim2.new(0, 10, 0, 10) })
                        end
                    end
                end)

                local sConn2 = UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        updateFromInput(input)
                    end
                end)

                table.insert(DiceUI._connections, sConn1)
                table.insert(DiceUI._connections, sConn2)

                DiceUI.Options[id] = sliderObj
                task.defer(adaptColumns)
                return sliderObj
            end

            --==================================================
            -- CONTROL: DROPDOWN (COMPACT 30PX TRIGGER + AUTO-CLOSING TRAY)
            --==================================================
            function Section:AddDropdown(id: string, dCfg: {
                Name: string,
                Options: { string },
                Default: string?,
                Multi: boolean?,
                Callback: ((any) -> ())?
            })
                elementOrder = elementOrder + 1
                local dName = dCfg.Name or id
                local options = dCfg.Options or {}
                local isMulti = dCfg.Multi == true
                local current = dCfg.Default or (isMulti and {} or options[1] or "")
                local callback = dCfg.Callback
                local isOpen = false

                local selectedTable: { [string]: boolean } = {}
                if isMulti then
                    if typeof(current) == "table" then
                        for _, opt in ipairs(current) do selectedTable[opt] = true end
                    end
                end

                -- Container (Starts compact at 30px)
                local row = Instance.new("Frame")
                row.Name = "Dropdown_" .. id
                row.Size = UDim2.new(1, 0, 0, 30)
                row.BackgroundColor3 = Theme.ItemBg
                row.BackgroundTransparency = 0.5
                row.Active = false
                row.ClipsDescendants = true
                row.LayoutOrder = elementOrder
                addCorner(row, 6)
                local rowStroke = addStroke(row, Theme.Border, 1, 0.75)
                row.Parent = card

                local titleLbl = Instance.new("TextLabel")
                titleLbl.Size = UDim2.new(0.48, -8, 0, 30)
                titleLbl.Position = UDim2.new(0, 8, 0, 0)
                titleLbl.BackgroundTransparency = 1
                titleLbl.Font = Theme.FontMedium
                titleLbl.Text = dName
                titleLbl.TextColor3 = Theme.TextBody
                titleLbl.TextSize = 11
                titleLbl.TextXAlignment = Enum.TextXAlignment.Left
                titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
                titleLbl.Active = false
                titleLbl.Parent = row

                -- Luxury 3D Selector Badge
                local selBadge = Instance.new("Frame")
                selBadge.Name = "SelBadge"
                selBadge.Size = UDim2.new(0.48, 0, 0, 22)
                selBadge.Position = UDim2.new(1, -8, 0, 4)
                selBadge.AnchorPoint = Vector2.new(1, 0)
                selBadge.BackgroundColor3 = Color3.fromRGB(18, 21, 28)
                selBadge.BackgroundTransparency = 0.15
                selBadge.Active = false
                addCorner(selBadge, 5)
                local selStroke = addStroke(selBadge, Color3.fromRGB(48, 42, 68), 1, 0.5)
                local selBevelGrad = Instance.new("UIGradient")
                selBevelGrad.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0.0, Color3.fromRGB(30, 34, 46)),
                    ColorSequenceKeypoint.new(1.0, Color3.fromRGB(16, 18, 25))
                })
                selBevelGrad.Rotation = 90
                selBevelGrad.Parent = selBadge
                selBadge.Parent = row

                local selText = Instance.new("TextLabel")
                selText.Size = UDim2.new(1, -22, 1, 0)
                selText.Position = UDim2.new(0, 7, 0, 0)
                selText.BackgroundTransparency = 1
                selText.Font = Theme.FontBold
                selText.Text = isMulti and "Select..." or tostring(current)
                selText.TextColor3 = Theme.AccentLight
                selText.TextSize = 10
                selText.TextXAlignment = Enum.TextXAlignment.Left
                selText.TextTruncate = Enum.TextTruncate.AtEnd
                selText.Active = false
                selText.Parent = selBadge

                local chevron = Instance.new("ImageLabel")
                chevron.Size = UDim2.new(0, 12, 0, 12)
                chevron.Position = UDim2.new(1, -14, 0.5, 0)
                chevron.AnchorPoint = Vector2.new(0, 0.5)
                chevron.BackgroundTransparency = 1
                chevron.Image = Icons.ChevronDown
                chevron.ImageColor3 = Theme.Accent
                chevron.Active = false
                chevron.Parent = selBadge

                -- Interactive Trigger Button
                local triggerBtn = Instance.new("TextButton")
                triggerBtn.Name = "Trigger"
                triggerBtn.BackgroundTransparency = 1
                triggerBtn.Text = ""
                triggerBtn.AutoButtonColor = false
                triggerBtn.ZIndex = 3
                if UserInputService.TouchEnabled then
                    triggerBtn.Size = UDim2.new(0.48, 0, 0, 30)
                    triggerBtn.Position = UDim2.new(1, 0, 0, 0)
                    triggerBtn.AnchorPoint = Vector2.new(1, 0)
                else
                    triggerBtn.Size = UDim2.new(1, 0, 0, 30)
                    triggerBtn.Position = UDim2.new(0, 0, 0, 0)
                end
                triggerBtn.Parent = row

                triggerBtn.MouseEnter:Connect(function()
                    makeTween(row, 0.15, { BackgroundTransparency = 0.25 })
                    makeTween(selBadge, 0.15, { BackgroundTransparency = 0.05 })
                    makeTween(selStroke, 0.15, { Color = Theme.Accent, Transparency = 0.3 })
                end)
                triggerBtn.MouseLeave:Connect(function()
                    makeTween(row, 0.15, { BackgroundTransparency = 0.5 })
                    makeTween(selBadge, 0.15, { BackgroundTransparency = 0.15 })
                    makeTween(selStroke, 0.15, { Color = Color3.fromRGB(48, 42, 68), Transparency = 0.5 })
                end)

                -- Luxury 3D Elevated Option Tray
                -- INVARIANT: Starts collapsed with Size = 0, Visible = false, ScrollingEnabled = false
                local optScroll = Instance.new("ScrollingFrame")
                optScroll.Name = "OptionTray"
                optScroll.Size = UDim2.new(1, -16, 0, 0)
                optScroll.Position = UDim2.new(0, 8, 0, 34)
                optScroll.BackgroundColor3 = Color3.fromRGB(14, 16, 23)
                optScroll.BackgroundTransparency = 0.05
                optScroll.BorderSizePixel = 0
                optScroll.ScrollBarThickness = 2
                optScroll.ScrollBarImageColor3 = Theme.Accent
                optScroll.ScrollingEnabled = false
                optScroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
                optScroll.ScrollingDirection = Enum.ScrollingDirection.Y
                optScroll.Selectable = false
                optScroll.AutomaticCanvasSize = Enum.AutomaticSize.None
                optScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
                optScroll.Visible = false
                optScroll.Active = true
                addCorner(optScroll, 6)
                local optTrayStroke = addStroke(optScroll, Color3.fromRGB(56, 44, 82), 1, 0.35)
                addPadding(optScroll, 4, 4, 4, 4)
                optScroll.Parent = row

                local optList = Instance.new("UIListLayout")
                optList.Padding = UDim.new(0, 3)
                optList.SortOrder = Enum.SortOrder.LayoutOrder
                optList.Parent = optScroll

                local dropdownObj = {
                    Value = current,
                    _row = row,
                    Close = function(self)
                        if isOpen then
                            isOpen = false
                            local tw = makeTween(row, 0.18, { Size = UDim2.new(1, 0, 0, 30) })
                            makeTween(chevron, 0.18, { Rotation = 0 })
                            if DiceUI._activeDropdown == self then
                                DiceUI._activeDropdown = nil
                            end
                            tw.Completed:Connect(function()
                                if not isOpen then
                                    optScroll.Visible = false
                                    optScroll.ScrollingEnabled = false
                                    optScroll.Size = UDim2.new(1, -16, 0, 0)
                                end
                                adaptColumns()
                            end)
                            task.defer(adaptColumns)
                        end
                    end,
                    Open = function(self)
                        if not isOpen then
                            if DiceUI._activeDropdown and DiceUI._activeDropdown ~= self then
                                DiceUI._activeDropdown:Close()
                            end
                            DiceUI._activeDropdown = self
                            isOpen = true
                            local trayHeight = math.min(#options * 26 + 10, 125)
                            optScroll.Visible = true
                            optScroll.ScrollingEnabled = true
                            optScroll.Size = UDim2.new(1, -16, 0, trayHeight)
                            local tw = makeTween(row, 0.2, { Size = UDim2.new(1, 0, 0, 36 + trayHeight) })
                            makeTween(chevron, 0.2, { Rotation = 180 })
                            tw.Completed:Connect(function()
                                adaptColumns()
                            end)
                            task.defer(adaptColumns)
                        end
                    end,
                    SetValue = function(self, val: any)
                        self.Value = val
                        if isMulti then
                            local keys = {}
                            for k, v in pairs(selectedTable) do
                                if v then table.insert(keys, k) end
                            end
                            selText.Text = (#keys > 0) and table.concat(keys, ", ") or "None"
                        else
                            selText.Text = tostring(val)
                        end
                        if callback then task.spawn(callback, self.Value) end
                    end,
                    Refresh = function(self, newOpts: { string })
                        for _, c in ipairs(optScroll:GetChildren()) do
                            if c:IsA("TextButton") then c:Destroy() end
                        end
                        for _, opt in ipairs(newOpts) do
                            local isSelected = isMulti and (selectedTable[opt] == true) or (self.Value == opt)

                            local oBtn = Instance.new("TextButton")
                            oBtn.Size = UDim2.new(1, 0, 0, 24)
                            oBtn.BackgroundColor3 = isSelected and Color3.fromRGB(36, 26, 56) or Color3.fromRGB(20, 23, 32)
                            oBtn.BackgroundTransparency = isSelected and 0.2 or 0.5
                            oBtn.Font = Theme.FontMedium
                            -- Keep leading spaces so btn.Text:find("Wolf") strictly matches
                            oBtn.Text = "   " .. opt
                            oBtn.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or Theme.TextBody
                            oBtn.TextSize = 10
                            oBtn.TextXAlignment = Enum.TextXAlignment.Left
                            oBtn.AutoButtonColor = false
                            addCorner(oBtn, 4)
                            oBtn.Parent = optScroll

                            -- Left glowing indicator pill for selected item
                            local ind = Instance.new("Frame")
                            ind.Name = "Indicator"
                            ind.Size = UDim2.new(0, 2, 0, 14)
                            ind.Position = UDim2.new(0, 2, 0.5, 0)
                            ind.AnchorPoint = Vector2.new(0, 0.5)
                            ind.BackgroundColor3 = Theme.Accent
                            ind.BackgroundTransparency = isSelected and 0 or 1
                            addCorner(ind, 1)
                            ind.Parent = oBtn

                            local checkIcon = Instance.new("ImageLabel")
                            checkIcon.Size = UDim2.new(0, 12, 0, 12)
                            checkIcon.Position = UDim2.new(1, -16, 0.5, 0)
                            checkIcon.AnchorPoint = Vector2.new(0, 0.5)
                            checkIcon.BackgroundTransparency = 1
                            checkIcon.Image = Icons.Check
                            checkIcon.ImageColor3 = Theme.Accent
                            checkIcon.Visible = isSelected
                            checkIcon.Parent = oBtn

                            oBtn.MouseButton1Click:Connect(function()
                                if isMulti then
                                    selectedTable[opt] = not selectedTable[opt]
                                    checkIcon.Visible = selectedTable[opt]
                                    ind.BackgroundTransparency = selectedTable[opt] and 0 or 1
                                    oBtn.BackgroundColor3 = selectedTable[opt] and Color3.fromRGB(36, 26, 56) or Color3.fromRGB(20, 23, 32)
                                    oBtn.TextColor3 = selectedTable[opt] and Color3.fromRGB(255, 255, 255) or Theme.TextBody
                                    self:SetValue(selectedTable)
                                else
                                    self:SetValue(opt)
                                    self:Close()
                                    for _, sibling in ipairs(optScroll:GetChildren()) do
                                        if sibling:IsA("TextButton") then
                                            local chk = sibling:FindFirstChildOfClass("ImageLabel")
                                            local sInd = sibling:FindFirstChild("Indicator")
                                            local isThis = (sibling.Text == "   " .. opt or sibling.Text == "  " .. opt)
                                            if chk then chk.Visible = isThis end
                                            if sInd then sInd.BackgroundTransparency = isThis and 0 or 1 end
                                            sibling.BackgroundColor3 = isThis and Color3.fromRGB(36, 26, 56) or Color3.fromRGB(20, 23, 32)
                                            sibling.TextColor3 = isThis and Color3.fromRGB(255, 255, 255) or Theme.TextBody
                                        end
                                    end
                                end
                            end)

                            oBtn.MouseEnter:Connect(function()
                                makeTween(oBtn, 0.12, { BackgroundColor3 = Color3.fromRGB(32, 26, 50), BackgroundTransparency = 0.1, TextColor3 = Color3.fromRGB(255, 255, 255) })
                            end)
                            oBtn.MouseLeave:Connect(function()
                                local activeNow = isMulti and selectedTable[opt] or (self.Value == opt)
                                makeTween(oBtn, 0.12, {
                                    BackgroundColor3 = activeNow and Color3.fromRGB(36, 26, 56) or Color3.fromRGB(20, 23, 32),
                                    BackgroundTransparency = activeNow and 0.2 or 0.5,
                                    TextColor3 = activeNow and Color3.fromRGB(255, 255, 255) or Theme.TextBody
                                })
                            end)
                        end
                        local function updateOptCanvas()
                            optScroll.CanvasSize = UDim2.new(0, 0, 0, optList.AbsoluteContentSize.Y + 8)
                        end
                        optList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateOptCanvas)
                        task.defer(updateOptCanvas)
                    end
                }

                triggerBtn.MouseButton1Click:Connect(function()
                    if isOpen then
                        dropdownObj:Close()
                    else
                        dropdownObj:Open()
                    end
                end)

                dropdownObj:Refresh(options)
                DiceUI.Options[id] = dropdownObj
                task.defer(adaptColumns)
                return dropdownObj
            end

            --==================================================
            -- CONTROL: BUTTON (COMPACT 30PX ACTION BUTTON)
            --==================================================
            function Section:AddButton(bCfg: {
                Name: string,
                Icon: string?,
                Style: string?,
                Callback: (() -> ())?
            })
                elementOrder = elementOrder + 1
                local bName = bCfg.Name or "Button"
                local callback = bCfg.Callback
                local style = bCfg.Style or "Secondary"

                local isPrimary = (style == "Primary")
                local isDanger = (style == "Danger")

                local btn = Instance.new("TextButton")
                btn.Name = "Button_" .. bName
                btn.Size = UDim2.new(1, 0, 0, 30)
                btn.BackgroundColor3 = isPrimary and Color3.fromRGB(128, 52, 210) or (isDanger and Color3.fromRGB(58, 22, 28) or Theme.CardBg)
                btn.BackgroundTransparency = (isPrimary or isDanger) and 0.2 or 0.4
                btn.Text = ""
                btn.AutoButtonColor = false
                btn.LayoutOrder = elementOrder
                btn.ClipsDescendants = true
                addCorner(btn, 6)
                local btnStroke = addStroke(btn, isDanger and Theme.Danger or (isPrimary and Theme.Accent or Theme.Border), 1, (isPrimary or isDanger) and 0.25 or 0.6)
                if isPrimary then
                    local btnGrad = Instance.new("UIGradient")
                    btnGrad.Color = Theme.AccentGradient
                    btnGrad.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.15),
                        NumberSequenceKeypoint.new(1, 0.35)
                    })
                    btnGrad.Parent = btn
                end
                btn.Parent = card

                local bLayout = Instance.new("UIListLayout")
                bLayout.FillDirection = Enum.FillDirection.Horizontal
                bLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                bLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                bLayout.Padding = UDim.new(0, 6)
                bLayout.Parent = btn

                if bCfg.Icon then
                    local bIconAsset = DiceUI:GetIcon(bCfg.Icon)
                    local bIcon = Instance.new("ImageLabel")
                    bIcon.Size = UDim2.new(0, 14, 0, 14)
                    bIcon.BackgroundTransparency = 1
                    bIcon.Image = bIconAsset
                    if bIconAsset == Icons.Dice or bIconAsset == LOGO_IMAGE_ID then
