        -- Responsive Width Adapter & Exact Dynamic CanvasSize Computation
        local function adaptColumns()
            local w = contentArea.AbsoluteSize.X
            local isStacked = (w < 440)
            local totalH = 0

            local leftH = leftCol.AbsoluteSize.Y
            local rightH = rightCol.AbsoluteSize.Y
            local fullH = fullCol.AbsoluteSize.Y

            if isStacked then
                -- Single-column stacked mode (Mobile / squished viewport)
                leftCol.Size = UDim2.new(1, 0, 0, 0)
                leftCol.Position = UDim2.new(0, 0, 0, 0)

                local rightOffset = (leftH > 0) and (leftH + 8) or 0
                rightCol.Size = UDim2.new(1, 0, 0, 0)
                rightCol.Position = UDim2.new(0, 0, 0, rightOffset)

                local fullOffset = rightOffset + ((rightH > 0) and (rightH + 8) or 0)
                fullCol.Size = UDim2.new(1, 0, 0, 0)
                fullCol.Position = UDim2.new(0, 0, 0, fullOffset)

                totalH = fullOffset + fullH
            else
                -- Two-column symmetrical grid mode (Desktop: 10px / 265px / 10px / 265px / 10px)
                leftCol.Size = UDim2.new(0.5, -5, 0, 0)
                leftCol.Position = UDim2.new(0, 0, 0, 0)

                rightCol.Size = UDim2.new(0.5, -5, 0, 0)
                rightCol.Position = UDim2.new(0.5, 5, 0, 0)

                local maxColH = math.max(leftH, rightH)
                local fullOffset = (maxColH > 0) and (maxColH + 8) or 0
                fullCol.Size = UDim2.new(1, 0, 0, 0)
                fullCol.Position = UDim2.new(0, 0, 0, fullOffset)

                totalH = fullOffset + fullH
            end

            colContainer.Size = UDim2.new(1, -20, 0, totalH)
            page.CanvasSize = UDim2.new(0, 0, 0, totalH + 30)
        end

